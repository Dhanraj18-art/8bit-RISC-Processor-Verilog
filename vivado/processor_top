module processor_top (
    input clk,
    input reset,
    output [7:0] led
);

wire slow_clk;
reg [25:0] counter = 0;

// Clock Divider (100MHz → ~1Hz)
always @(posedge clk) begin
    counter <= counter + 1;
end

assign slow_clk = counter[25];  // slow clock

wire [7:0] pc_out;
wire [7:0] instruction;
wire [7:0] read_data1, read_data2;
wire [7:0] alu_result;
wire reg_write;
wire [2:0] alu_op;

// PC
pc PC(slow_clk, reset, pc_out);

// Instruction Memory
instruction_memory IM(pc_out, instruction);

// Control Unit
control_unit CU(instruction[7:5], reg_write, alu_op);

// Register File
register_file RF(
    slow_clk,
    reg_write,
    instruction[4:3],
    instruction[2:1],
    instruction[4:3],
    alu_result,
    read_data1,
    read_data2
);

// ALU
alu ALU(
    read_data1,
    read_data2,
    alu_op,
    alu_result
);

// Show PC on LEDs
assign led = pc_out;

endmodule